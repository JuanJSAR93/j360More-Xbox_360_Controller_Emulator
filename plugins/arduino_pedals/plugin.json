{
  "id": "arduino_pedals",
  "name": {
    "es": "Pedales Arduino USB",
    "en": "Arduino USB Pedals",
    "fr": "Pédales USB Arduino",
    "pt_BR": "Pedais USB Arduino",
    "de": "Arduino USB-Pedale",
    "it": "Pedali USB Arduino",
    "ru": "Arduino USB Педали"
  },
  "version": "1.0.0",
  "author": "Comunidad j360More",
  "description": {
    "es": "Lectura analógica de acelerador (RT), freno (LT) y embrague (LB) vía comunicación Serial (Arduino / ESP32) con telemetría en vivo y soporte háptico.",
    "en": "Analog reading of throttle (RT), brake (LT) and clutch (LB) via Serial communication (Arduino / ESP32) with live telemetry and haptic rumble.",
    "fr": "Lecture analogique de l'accélérateur (RT), du frein (LT) et de l'embrayage (LB) via communication Série (Arduino / ESP32) avec télémétrie en direct et retour haptique.",
    "pt_BR": "Leitura analógica de acelerador (RT), freio (LT) e embreagem (LB) via comunicação Serial (Arduino / ESP32) com telemetria ao vivo e vibração háptica.",
    "de": "Analoge Erfassung von Gas (RT), Bremse (LT) und Kupplung (LB) über serielle Kommunikation (Arduino / ESP32) mit Live-Telemetrie und haptischem Feedback.",
    "it": "Lettura analogica di acceleratore (RT), freno (LT) e frizione (LB) tramite comunicazione Seriale (Arduino / ESP32) con telemetria in tempo reale e feedback aptico.",
    "ru": "Аналоговое считывание газа (RT), тормоза (LT) и сцепления (LB) через последовательный порт (Arduino / ESP32) с телеметрией и виброотдачей."
  },
  "entrypoint": "main.py",
  "requirements": [
    "pyserial>=3.5"
  ],
  "global_ui": {
    "title": {
      "es": "Ajustes de Conexión Serial",
      "en": "Serial Connection Settings",
      "fr": "Paramètres de Connexion Série",
      "pt_BR": "Configurações de Conexão Serial",
      "de": "Serielle Verbindungseinstellungen",
      "it": "Impostazioni Connessione Seriale",
      "ru": "Настройки последовательного порта"
    },
    "fields": [
      {
        "id": "com_port",
        "label": {
          "es": "Puerto COM / Serial:",
          "en": "COM / Serial Port:",
          "fr": "Port COM / Série :",
          "pt_BR": "Porta COM / Serial:",
          "de": "COM / Serieller Anschluss:",
          "it": "Porta COM / Seriale:",
          "ru": "COM / Последовательный порт:"
        },
        "type": "dynamic_dropdown",
        "discovery_action": "scan_ports",
        "options": ["AUTO", "COM1", "COM3", "COM4", "COM5"],
        "default": "AUTO"
      },
      {
        "id": "baudrate",
        "label": {
          "es": "Velocidad (Baudios):",
          "en": "Baud Rate:",
          "fr": "Vitesse (Bauds) :",
          "pt_BR": "Taxa de Transmissão (Baud):",
          "de": "Baudrate:",
          "it": "Baud Rate:",
          "ru": "Скорость (Бод):"
        },
        "type": "dropdown",
        "options": [9600, 38400, 57600, 115200],
        "default": 115200
      },
      {
        "id": "emulate_hardware",
        "label": {
          "es": "Emular comportamiento (Simulador sin hardware)",
          "en": "Emulate behavior (Hardware simulator)",
          "fr": "Émuler le comportement (Simulateur)",
          "pt_BR": "Emular comportamento (Simulador)",
          "de": "Verhalten emulieren (Simulator)",
          "it": "Emula comportamento (Simulatore)",
          "ru": "Эмулировать поведение (Симулятор)"
        },
        "type": "checkbox",
        "default": true
      },
      {
        "id": "auto_map_controller",
        "label": {
          "es": "Auto-mapear controles al asignar a un mando",
          "en": "Auto-map controls when assigning to a controller",
          "fr": "Auto-mapper les contrôles lors de l'assignation",
          "pt_BR": "Auto-mapear controles ao atribuir a um controle",
          "de": "Steuerung automatisch zuweisen beim Belegen",
          "it": "Auto-mappa i controlli all'assegnazione",
          "ru": "Автоматически назначать кнопки при привязке"
        },
        "type": "checkbox",
        "default": true
      }
    ]
  },
  "default_mappings": {
    "RIGHT_TRIGGER": "Axis 1",
    "LEFT_TRIGGER": "Axis 2",
    "LEFT_SHOULDER": "Axis 3"
  },
  "auto_map_controller": true,
  "pad_ui_customization": {
    "disable_default_tabs": [
      "sticks"
    ],
    "custom_tabs": [
      {
        "id": "pedals_calibration",
        "title": {
          "es": "🔌 Calibración de Pedales",
          "en": "🔌 Pedals Calibration",
          "fr": "🔌 Calibrage des Pédales",
          "pt_BR": "🔌 Calibração de Pedais",
          "de": "🔌 Pedalkalibrierung",
          "it": "🔌 Calibrazione Pedali",
          "ru": "🔌 Калибровка педалей"
        },
        "sections": [
          {
            "name": {
              "es": "Rangos Analógicos y Zonas Muertas",
              "en": "Analog Ranges & Deadzones",
              "fr": "Plages Analogiques et Zones Mortes",
              "pt_BR": "Faixas Analógicas e Zonas Mortas",
              "de": "Analoge Bereiche & Totzonen",
              "it": "Intervalli Analogici e Zone Morte",
              "ru": "Аналоговые диапазоны и мертвые зоны"
            },
            "fields": [
              {
                "id": "gas_min",
                "label": {
                  "es": "Mínimo Acelerador (ADC):",
                  "en": "Minimum Throttle (ADC):",
                  "fr": "Accélérateur Minimum (ADC) :",
                  "pt_BR": "Mínimo Acelerador (ADC):",
                  "de": "Gas Minimalwert (ADC):",
                  "it": "Minimo Acceleratore (ADC):",
                  "ru": "Минимум газа (ADC):"
                },
                "type": "slider",
                "min": 0,
                "max": 1023,
                "default": 35
              },
              {
                "id": "gas_max",
                "label": {
                  "es": "Máximo Acelerador (ADC):",
                  "en": "Maximum Throttle (ADC):",
                  "fr": "Accélérateur Maximum (ADC) :",
                  "pt_BR": "Máximo Acelerador (ADC):",
                  "de": "Gas Maximalwert (ADC):",
                  "it": "Massimo Acceleratore (ADC):",
                  "ru": "Максимум газа (ADC):"
                },
                "type": "slider",
                "min": 0,
                "max": 1023,
                "default": 980
              },
              {
                "id": "brake_min",
                "label": {
                  "es": "Mínimo Freno (ADC):",
                  "en": "Minimum Brake (ADC):",
                  "fr": "Frein Minimum (ADC) :",
                  "pt_BR": "Mínimo Freio (ADC):",
                  "de": "Bremse Minimalwert (ADC):",
                  "it": "Minimo Freno (ADC):",
                  "ru": "Минимум тормоза (ADC):"
                },
                "type": "slider",
                "min": 0,
                "max": 1023,
                "default": 20
              },
              {
                "id": "brake_max",
                "label": {
                  "es": "Máximo Freno (ADC):",
                  "en": "Maximum Brake (ADC):",
                  "fr": "Frein Maximum (ADC) :",
                  "pt_BR": "Máximo Freio (ADC):",
                  "de": "Bremse Maximalwert (ADC):",
                  "it": "Massimo Freno (ADC):",
                  "ru": "Максимум тормоза (ADC):"
                },
                "type": "slider",
                "min": 0,
                "max": 1023,
                "default": 950
              },
              {
                "id": "invert_brake",
                "label": {
                  "es": "Invertir Polaridad del Freno",
                  "en": "Invert Brake Polarity",
                  "fr": "Inverser la Polarité du Frein",
                  "pt_BR": "Inverter Polaridade do Freio",
                  "de": "Bremspolarität umkehren",
                  "it": "Inverti Polarità del Freno",
                  "ru": "Инвертировать полярность тормоза"
                },
                "type": "checkbox",
                "default": false
              }
            ]
          },
          {
            "name": {
              "es": "Telemetría en Vivo",
              "en": "Live Telemetry",
              "fr": "Télémétrie en Direct",
              "pt_BR": "Telemetria ao Vivo",
              "de": "Live-Telemetrie",
              "it": "Telemetria in Tempo Reale",
              "ru": "Телеметрия в реальном времени"
            },
            "fields": [
              {
                "id": "pedals_telemetry",
                "label": {
                  "es": "Presión de Pedales (Acelerador / Freno / Embrague):",
                  "en": "Pedal Pressure (Throttle / Brake / Clutch):",
                  "fr": "Pression des Pédales (Accélérateur / Frein / Embrayage) :",
                  "pt_BR": "Pressão dos Pedais (Acelerador / Freio / Embreagem):",
                  "de": "Pedaldruck (Gas / Bremse / Kupplung):",
                  "it": "Pressione Pedali (Acceleratore / Freno / Frizione):",
                  "ru": "Давление на педали (Газ / Тормоз / Сцепление):"
                },
                "type": "progress_bar_multi",
                "labels": {
                  "es": ["GAS", "FRENO", "EMBRAGUE"],
                  "en": ["THROTTLE", "BRAKE", "CLUTCH"],
                  "fr": ["ACCÉL", "FREIN", "EMBRAYAGE"],
                  "pt_BR": ["ACELERADOR", "FREIO", "EMBREAGEM"],
                  "de": ["GAS", "BREMSE", "KUPPLUNG"],
                  "it": ["ACCELERATORE", "FRENO", "FRIZIONE"],
                  "ru": ["ГАЗ", "ТОРМОЗ", "СЦЕПЛЕНИЕ"]
                }
              },
              {
                "id": "calibrate_zero",
                "label": {
                  "es": "Poner a Cero Posición de Reposo",
                  "en": "Zero Out Rest Position",
                  "fr": "Mettre à Zéro la Position de Repos",
                  "pt_BR": "Zerar Posição de Repouso",
                  "de": "Ruheposition nullen",
                  "it": "Azzera Posizione di Riposo",
                  "ru": "Обнулить положение покоя"
                },
                "type": "button",
                "action": "calibrate_zero"
              }
            ]
          }
        ]
      }
    ]
  }
}
